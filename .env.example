# Copia este archivo a .env y completa la clave antes de usar el LLM.
# Las pruebas de modelos y catálogos no necesitan clave.
# La consulta en vivo a las tiendas tampoco usa esta clave.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0
# Déjalo vacío para usar la API oficial de OpenAI.
OPENAI_BASE_URL=

# Fuentes habilitadas: consulta del catálogo público. No uses csv ni otro valor.
FUENTE_JUMBO=web
FUENTE_SUPERBOOM=web

CIUDAD_DEFECTO=Medellín
MAX_ACLARACIONES=3

# Cliente HTTP identificable. La pausa es por dominio, en segundos.
CATALOGO_USER_AGENT=AsistenteComprasAcademico/0.1 (proyecto universitario UPB; consulta de catalogo publico)
CATALOGO_TIMEOUT=25
CATALOGO_PAUSA=2
CATALOGO_MAX_RESULTADOS=8
